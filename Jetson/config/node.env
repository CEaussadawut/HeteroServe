# HeteroServe — Jetson Nano node configuration
# Created from config/node.env.example by the ThinkPad session, 2026-09-13.
#
# NOTE: .gitignore lists config/node.env, so upstream treats this file as
# machine-local. Pi4/ and Pi5/ commit theirs. scripts/03_deploy_nodes.sh rsyncs
# the folder to the node, so this file travels with a deploy either way.

# ---- Identity -------------------------------------------------------------
# Stable node id used in every results file and in the characterisation dataset.
NODE_ID=jetson-nano-01
NODE_ROLE=cuda-worker              # cuda-worker | cpu-worker | orchestrator
NODE_SOC=tegra-x1                  # 128-core Maxwell (sm_53), 4 GB shared LPDDR4

# ---- Paths ----------------------------------------------------------------
# Put these on the SD card only if you have no better option; a USB3 SSD makes
# model loading several times faster and avoids SD wear during long sweeps.
HS_ROOT="${HOME}/heteroserve"
LLAMA_SRC="${HS_ROOT}/llama.cpp"
LLAMA_BUILD="${LLAMA_SRC}/build"
LLAMA_BIN="${LLAMA_BUILD}/bin"
MODEL_DIR="${HS_ROOT}/models"

# ---- llama.cpp source pin -------------------------------------------------
# JetPack 4.6.x ships CUDA 10.2. Current llama.cpp master requires CUDA >= 11,
# so on a stock Nano the CUDA build of master will NOT compile. Two options:
#   (a) pin LLAMA_CPP_REF to the newest ref that still builds against CUDA 10.2
#       on this box, and record it here so the build is reproducible;
#   (b) build CPU-only (BUILD_CUDA=0) and keep the Nano as an ARM CPU worker.
# 20_build_llama_cpp.sh detects the CUDA version and tells you which you are in.
# Leave empty for "whatever master is today" (fine for the CPU-only build).
# >>> ONE REVISION since 2026-09-29: the two-revision exception of 2026-09-20 is RETIRED (user: "finish all the Next
# >>> CUDA steps"). This node is on the cluster pin b23701f7, like the Pis:
# >>>   - Vulkan: the unpatched pin in ~/llama.cpp (testbed/scripts/jetson_build_llama_vulkan.sh);
# >>>   - CUDA 10.2 / FP16: the pin plus testbed/patches/jetpack46-cuda102-b23701f.patch (v2, sha256 1f43a3e4...),
# >>>     built by testbed/scripts/jetson_build_llama_cuda.sh into ~/llama.cpp-cuda.
# >>> 20_build_llama_cpp.sh is CPU-only since 2026-09-29 (its unpatched CUDA path could not build at the pin, and
# >>> was removed); it refuses BUILD_CUDA=1 and points here.
# >>> What retired it, the old note's own condition ("a CUDA-10.2-buildable ref dated after 2025-04-18"): the pin +
# >>> patch v2 builds and runs CUDA here; CPU-backend parity holds (CUDA drifts from the CPU no more than the
# >>> unpatched Vulkan backend does); and this node now joins pooled RPC runs as a CUDA or a Vulkan worker.
# >>> Every Jetson CUDA figure still names patch v2 (it touches CUDA kernel code). Evidence: testbed/benchmarks.md,
# >>> 2026-09-29. History: b5050 = 23106f94ea2bc3da929afb7330655fd5515d08dc (2025-04-04), this node's ref from
# >>> 2026-09-20 to 2026-09-29; the full record of that split is Pi5/docs/PIN_CONFLICT.md.
LLAMA_CPP_REF="b23701f77d47dad9de834d59ebfcbe25c9e8b46f"
LLAMA_CPP_URL="https://github.com/ggml-org/llama.cpp.git"

BUILD_CUDA=0                       # 20_build builds CPU-only (NEON); its CUDA path was removed 2026-09-29.
                                   # CUDA at the pin: testbed/scripts/jetson_build_llama_cuda.sh (patch v2).
CUDA_ARCH=53                       # Maxwell GM20B on Tegra X1
BUILD_JOBS=2                       # 4 GB RAM: nvcc will OOM at -j4
HOST_CXX=g++-8                     # CUDA 10.2 refuses gcc > 8

# ---- RPC ------------------------------------------------------------------
RPC_BIND=0.0.0.0
RPC_PORT=50052
# The Nano's GPU shares the 4 GB with the OS. Advertise less than you have or
# the orchestrator will hand you a partition that OOMs mid-run.
RPC_MEM_MB=2048
# Unified memory lets an oversized partition spill to swap instead of dying.
# Good for survivability, terrible for throughput — off by default so the
# measurements stay honest. Turn on only for the deliberate over-commit runs.
CUDA_UNIFIED_MEMORY=0

# ---- Cluster cross-check --------------------------------------------------
# NOT read by any script in this folder. They exist so that
# ThinkPad/tests/test_repo_hygiene.py::test_cluster_json_agrees_with_each_node_env
# can assert this node against ThinkPad/config/cluster.json -- the check that
# caught the Pi 5 being recorded at .13 in one file and .12 in another.
# The address is still UNCONFIRMED against the actual switch.
ETH_ADDR=192.168.50.15
INA_CHANNEL=3

# ---- Cross-node identity --------------------------------------------------
# The id ThinkPad/config/cluster.json uses for this machine, which is what every
# consumer of the shared results.csv keys on -- ThinkPad/control/profiles.py
# groups by row["node_id"] with no alias resolution. NODE_ID above may be a
# longer local spelling ("jetson-nano-01"); ThinkPad's hygiene test maintains an
# ALIASES map for that, but the CSV cannot rely on it. Pi 4 and Pi 5 sidestep the
# problem by setting NODE_ID to the canonical id directly.
CLUSTER_NODE_ID=jetson

# ---- Measurement ----------------------------------------------------------
TELEMETRY_HZ=5                     # tegrastats sample rate (interval = 1000/HZ ms)
RESULTS_DIR="${HS_ROOT}/results"
# Barrel-jack (5V/4A) + J48 jumper is required for nvpmodel mode 0 (MAXN/10W).
# On micro-USB you must stay in mode 1 (5W) or the board will brown out.
NVP_MODEL=0                        # 0 = MAXN (10W), 1 = 5W
LOCK_CLOCKS=1                      # jetson_clocks: mandatory for reproducibility
FAN_PWM=255                        # 0-255; keep the fan pinned during sweeps

# ---- Models ---------------------------------------------------------------
# Small enough to fit the Nano's share of a 4 GB pool; the cluster runs bigger
# ones split across nodes.
MODELS="qwen2.5-0.5b-instruct-q4_k_m qwen2.5-1.5b-instruct-q4_k_m llama-3.2-1b-instruct-q4_k_m"
