+template <typename T_C_VKQ, typename T_B_KQ>
+static __device__ __forceinline__ void fattn_combine_write_impl(
+        half2 * tile_Q, const int tile_stride, const T_C_VKQ * VKQ_C,
+        const int k00, const int nbatch_combine, const int warp_y,
+        std::integral_constant<int, 8>, half2 (T_C_VKQ::*)[T_C_VKQ::ne]) {
+    const int jc_cwd = warp_y*T_B_KQ::I + T_B_KQ::get_i(-1); // jc combine write data
+#pragma unroll
