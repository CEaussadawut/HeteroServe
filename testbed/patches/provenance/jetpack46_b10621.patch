+static __device__ __forceinline__ T_B fattn_make_B_from_KQ_C(const T_C & c, std::integral_constant<int, 8>) {
+    return get_transposed(get_half2(c));
+}
+
+template <typename T_B, typename T_C, int CPW>
+static __device__ __forceinline__ T_B fattn_make_B_from_KQ_C(const T_C & c, std::integral_constant<int, CPW>) {
+    return get_half2(c);
