+// AMD: rescale VKQ accumulators with the new KQ max, dispatch on the accumulator element type.
+template <int DV, typename T_C_VKQ>
+static __device__ __forceinline__ void fattn_scale_vkq_amd(T_C_VKQ * VKQ_C, const float * KQ_max_scale,
+                                                           half2 (T_C_VKQ::*)[T_C_VKQ::ne]) {
+    const half2 KQ_max_scale_h2 = make_half2(KQ_max_scale[0], KQ_max_scale[0]);
+#pragma unroll
+    for (int i = 0; i < (DV/2)/T_C_VKQ::J; ++i) {
+#pragma unroll
+        for (int l = 0; l < T_C_VKQ::ne; ++l) {
+            VKQ_C[i].x[l] *= KQ_max_scale_h2;
+        }
+    }
+}
+
+template <int DV, typename T_C_VKQ>
+static __device__ __forceinline__ void fattn_scale_vkq_amd(T_C_VKQ * VKQ_C, const float * KQ_max_scale,
+                                                           float (T_C_VKQ::*)[T_C_VKQ::ne]) {
+#pragma unroll
+    for (int i = 0; i < DV/T_C_VKQ::J; ++i) {
+#pragma unroll
+        for (int l = 0; l < T_C_VKQ::ne; ++l) {
