+
+// KQ mma: for cols_per_warp == 8 the operands are used directly, otherwise A and B are
+// swapped for CUDA because the wide version of KQ_C is column-major.
+template <typename T_C, typename T_A, typename T_B>
+static __device__ __forceinline__ void fattn_mma_KQ(T_C & c, const T_A & a, const T_B & b, std::integral_constant<int, 8>) {
+    mma(c, a, b);
+}
+
+template <typename T_C, typename T_A, typename T_B, int CPW>
+static __device__ __forceinline__ void fattn_mma_KQ(T_C & c, const T_A & a, const T_B & b, std::integral_constant<int, CPW>) {
+    // Wide version of KQ_C is column-major
+#if defined(AMD_WMMA_AVAILABLE) || defined(AMD_MFMA_AVAILABLE)
+    // AMD matrix C is column-major.
+    mma(c, a, b);
+#else
+    // swap A and B for CUDA.
+    mma(c, b, a);
+#endif // defined(AMD_WMMA_AVAILABLE) || defined(AMD_MFMA_AVAILABLE)
+}
+
+// VKQ mma: direct operand order for T_B_KQ::I == 8, otherwise A and B are swapped for CUDA.
+template <typename T_C, typename T_A, typename T_B>
+static __device__ __forceinline__ void fattn_mma_VKQ(T_C & c, const T_A & a, const T_B & b, std::integral_constant<int, 8>) {
+    mma(c, a, b);
+}
+
+template <typename T_C, typename T_A, typename T_B, int TBKQ_I>
+static __device__ __forceinline__ void fattn_mma_VKQ(T_C & c, const T_A & a, const T_B & b, std::integral_constant<int, TBKQ_I>) {
+    // Wide version of VKQ_C is column-major.
+#if defined(AMD_WMMA_AVAILABLE) || defined(AMD_MFMA_AVAILABLE)
+    // AMD matrix C is column-major.
+    mma(c, a, b);
+#else
+    // swap A and B for CUDA.
+    mma(c, b, a);
+#endif // defined(AMD_WMMA_AVAILABLE) || defined(AMD_MFMA_AVAILABLE)
+}
