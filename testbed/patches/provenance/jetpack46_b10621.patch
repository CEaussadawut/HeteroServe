+#pragma unroll
+        for (int l = 0; l < T_B_KQ::ne; ++l) {
+            const int k = k1 + T_B_KQ::get_j(l);
+
+            tile_Q[jc_cwd*tile_stride + k] = B.x[l];
+        }
+    }
+}
