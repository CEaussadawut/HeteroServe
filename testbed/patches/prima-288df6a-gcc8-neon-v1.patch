--- a/ggml/src/ggml-cpu-impl.h
+++ b/ggml/src/ggml-cpu-impl.h
@@ -363,9 +363,36 @@
 
 #define ggml_vld1q_s16_x2 vld1q_s16_x2
 #define ggml_vld1q_u8_x2  vld1q_u8_x2
-#define ggml_vld1q_u8_x4  vld1q_u8_x4
 #define ggml_vld1q_s8_x2  vld1q_s8_x2
+#if defined(__GNUC__) && !defined(__clang__) && __GNUC__ < 9
+// gcc 8's arm_neon.h has no vld1q_u8_x4 / vld1q_s8_x4 (they came in gcc 9; prima.cpp's README asks for gcc >= 9). Four plain
+// 16-byte loads of the same 64 bytes instead, as the 32-bit branch above does. HeteroServe, for the Jetson's g++-8:
+// testbed/patches/prima-288df6a-gcc8-neon-v1.patch (2026-10-21).
+inline static uint8x16x4_t ggml_vld1q_u8_x4(const uint8_t * ptr) {
+    uint8x16x4_t res;
+
+    res.val[0] = vld1q_u8(ptr + 0);
+    res.val[1] = vld1q_u8(ptr + 16);
+    res.val[2] = vld1q_u8(ptr + 32);
+    res.val[3] = vld1q_u8(ptr + 48);
+
+    return res;
+}
+
+inline static int8x16x4_t ggml_vld1q_s8_x4(const int8_t * ptr) {
+    int8x16x4_t res;
+
+    res.val[0] = vld1q_s8(ptr + 0);
+    res.val[1] = vld1q_s8(ptr + 16);
+    res.val[2] = vld1q_s8(ptr + 32);
+    res.val[3] = vld1q_s8(ptr + 48);
+
+    return res;
+}
+#else
+#define ggml_vld1q_u8_x4  vld1q_u8_x4
 #define ggml_vld1q_s8_x4  vld1q_s8_x4
+#endif
 #define ggml_vqtbl1q_s8   vqtbl1q_s8
 #define ggml_vqtbl1q_u8   vqtbl1q_u8
 
