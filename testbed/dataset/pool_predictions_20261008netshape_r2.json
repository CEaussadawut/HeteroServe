  "file": "testbed/dataset/pool_predictions_20261008netshape.json",
  "sha256": "736fcafab1a44e5756c84baf0d0fb64a51cfa0c0fb2586a11aff1fc171557667",
  "why": "The router changed (the T628L stopped about 13:57 and was replaced by the home router 192.168.1.1, about 17:00). The first registration's cells launch -rpc 192.168.100.111:50052, which no longer exists: the Jetson is 192.168.1.109. Same cells, settings and hypotheses. The base link was re-measured on the new router (pi4-jetson 938.8 Mbit/s, 1.081 ms, against 938.1 and 0.612 on the T628L), and netshape.sh, measure_link.sh and the GATE-NET checks were updated for the new subnet. No cell of the first registration ever ran."
 },
 "hypotheses": [
  {
   "id": "NS-FLIP",
   "claim": "at every setting where the re-priced predictions of the two layouts differ by >= 3 %, the layout predicted faster measures faster in decode"
  },
  {
   "id": "NS-CROSS",
   "claim": "the crossover interpolated from the measured decode gaps (linear in 1/bandwidth between the bracketing settings) is within a factor 1.5 of the re-priced crossover"
  },
  {
   "id": "NS-ACC",
   "claim": "every cell's measured decode is within 10 % of its re-priced prediction"
  },
  {
   "id": "NS-RTT",
   "claim": "per layout, decode's increase over s0 at d1 and d5 against the measured RTT increase, fitted through the origin, has a slope in [1.5, 2.5] (the predictor charges 2)"
  }
 ]
}