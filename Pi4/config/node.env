# HeteroServe -- Pi 4 node configuration
# Shell-sourceable AND parsed by node/envfile.py. Keep it KEY=value, no spaces.

# ---------- identity ----------
NODE_ID=pi4
NODE_ROLE=worker-straggler
NODE_DESC="Raspberry Pi 4 Model B 8GB (Cortex-A72) -- deliberate straggler worker"
NODE_ARCH=aarch64
NODE_SOC=BCM2711
NODE_CPU=Cortex-A72
NODE_CORES=4
NODE_RAM_MB=8192
# The layer budget the control node actually plans against: profiles.py reads this (via
# the agent's device_info "usable_budget_mb"), and nothing reads RPC_MEM_MB at all.
# Set to the 2600 MB headroom figure the design has always claimed, because upstream
# rpc-server has no --mem flag -- it advertises the board's real free memory -- so this
# is the ONLY place the headroom can be enforced. Proposal Appendix B's ~3.2 GB is what
# the OS leaves free; the further 600 MB is deliberate slack, since this node has no swap
# and an OOM mid-run destroys a measurement rather than just slowing it.
# That ~3.2 GB was for a 4 GB board. This one is 8 GB (revision d03115) with about 7.4 GB free at rest
# (testbed/dataset/memory_at_rest.json), so the figure below was sized for the wrong board:
# .handoff/nodes/Pi4/2026-09-27-2100-NOTE-memory-budget-vs-measured.md.
# systemd/heteroserve-rpc.service caps at MemoryHigh=2800M / MemoryMax=3G, i.e. ABOVE this
# budget, so the cgroup stays a backstop and never binds before the planner does.
NODE_USABLE_MB=2600

# ---------- network ----------
# Wired tier (primary, GbE through the TL-SG108E managed switch)
ETH_IFACE=eth0
# 2026-09-29: the wired overlay; was the proposal's 192.168.50.x (NOTE in .handoff/nodes/Pi4/)
ETH_ADDR=192.168.10.12
# Wireless tier (low tier, existing AP)
WLAN_IFACE=wlan0
# Control node (ThinkPad T580): cluster manager + energy collector + NTP server
CONTROL_HOST=192.168.10.5
CONTROL_NTP=192.168.100.105

# ---------- llama.cpp ----------
LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
# Leave empty on the FIRST build; 02_build_llama_cpp.sh records the resolved SHA in
# build_manifest.json. Copy that SHA in here afterwards and never change it again --
# every measurement in the dataset must come from one pinned revision.
LLAMA_PIN_SHA=b23701f77d47dad9de834d59ebfcbe25c9e8b46f
LLAMA_SRC=/opt/heteroserve/llama.cpp
LLAMA_BIN=/opt/heteroserve/llama.cpp/build/bin
# Cortex-A72 is ARMv8-A + NEON + CRC. It has NO dotprod and NO i8mm. dotprod arrives
# with the A76 on the Pi 5; i8mm does NOT (i8mm is ARMv8.6, Cortex-A710 and later,
# and the A76 is ARMv8.2), so the Pi4/Pi5 ISA contrast rests on dotprod alone.
# Flags are written out explicitly instead of relying on -march=native so the build
# is reproducible and so the Pi4/Pi5 difference is a recorded fact, not an accident.
LLAMA_ARCH_FLAGS="-march=armv8-a+crc+simd -mtune=cortex-a72"
LLAMA_THREADS=4

# ---------- rpc-server ----------
RPC_HOST=0.0.0.0
RPC_PORT=50052
# Used ONLY if this build of rpc-server still accepts --mem. scripts/lib.sh
# rpc_extra_args() probes `--help` and passes `--mem $RPC_MEM_MB` when the flag is there;
# upstream REMOVED it (41386cf, 2025-10-17), so on a current master build the flag is
# absent, the server reports the board's ACTUAL free memory over GET_DEVICE_MEMORY, and
# this number reaches nothing. rpc_extra_args() warns loudly in that case.
# Either way NODE_USABLE_MB above is what the placement engine plans against, so that is
# where the headroom has to be real.
RPC_MEM_MB=2600
RPC_CACHE_DIR=/opt/heteroserve/rpc-cache
# Threads the rpc server serves cluster traffic with. Kept SEPARATE from LLAMA_THREADS so
# the straggler study (QR8) can deliberately under-load this node during a cluster run
# without changing what the local characterisation sweep uses. Passed explicitly because
# upstream's default is hardware_concurrency()/2 -- 2 of this board's 4 cores -- which
# would otherwise differ from the sweep silently and go unrecorded.
RPC_THREADS=4

# ---------- node agent ----------
AGENT_PORT=9410

# ---------- power instrumentation ----------
# This node's channel on the Pico 2 DAQ. The INA226 sits high-side on the 5V USB-C rail,
# so EVERYTHING on that rail is measured: SoC, RAM, microSD, Ethernet PHY and the case fan.
INA_CHANNEL=2
INA_I2C_ADDR=0x41
INA_SHUNT_OHMS=0.01
INA_MAX_A=3.0
PSU_MODEL="Official 5.1V 3A USB-C"

# ---------- data ----------
DATA_DIR=/opt/heteroserve/data
