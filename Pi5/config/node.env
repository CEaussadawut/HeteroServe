# HeteroServe -- Pi 5 node configuration
# Shell-sourceable AND parsed by node/envfile.py. Keep it KEY=value, no spaces.

# ---------- identity ----------
NODE_ID=pi5
NODE_ROLE=worker-strong
NODE_DESC="Raspberry Pi 5 8GB (Cortex-A76) -- strongest ARM CPU worker"
NODE_ARCH=aarch64
NODE_SOC=BCM2712
NODE_CPU=Cortex-A76
NODE_CORES=4
NODE_RAM_MB=8192
# Usable after OS+runtime, per proposal Appendix B (Pi 5 ~ 7 GB)
NODE_USABLE_MB=7168

# ---------- network ----------
# Wired tier (GbE through the TL-SG108E managed switch)
ETH_IFACE=eth0
# 2026-09-29: the wired overlay; was the proposal's 192.168.50.x (NOTE in .handoff/nodes/Pi5/)
ETH_ADDR=192.168.10.11
# High tier (2.5GbE through a USB 3.0 adapter). The proposal equips only the
# three-node core -- control node, Pi 5, Jetson Nano -- with adapters. Leave
# ETH25_IFACE empty until the adapter is plugged in; 05_network_setup.sh skips
# the tier when it is empty instead of failing.
ETH25_IFACE=eth1
ETH25_ADDR=192.168.51.12
# Wireless tier (low tier, existing AP)
WLAN_IFACE=wlan0
# Control node (ThinkPad T580): cluster manager + energy collector + NTP server
CONTROL_HOST=192.168.10.5
CONTROL_NTP=192.168.100.105

# ---------- llama.cpp ----------
LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
# PINNED 2026-09-19 to b5050 (2025-04-04). This value did NOT come from a Pi 5 build --
# it was chosen by the Jetson Nano's CUDA 10.2 ceiling (the unpatched window is empty; the
# last stock-buildable ref is nine days BEFORE the -no-cnv floor) and is recorded
# authoritatively in ThinkPad/config/cluster.json -> "llama"."pin_sha", with the full
# rationale and the write-up obligation in the "_pin_note" beside it.
# Every node must build this same revision. The RPC opcode enum shifted between b4475 and
# b5050 (SET_TENSOR_HASH inserted at 7) and RPC_CMD_HELLO -- the version handshake -- only
# lands 2025-04-18, so a mixed-revision cluster SILENTLY MISEXECUTES rather than refusing
# to connect. Do not change this without changing all five locations in the same commit:
# Pi4/ and Pi5/ config/node.env (LLAMA_PIN_SHA), Jetson/ config/node.env and
# node.env.example (LLAMA_CPP_REF), and ThinkPad/config/cluster.json (llama.pin_sha).
# At this date rpc-server still accepts --mem and is named "rpc-server", not
# "ggml-rpc-server" -- 04_install_services.sh probes for both, so nothing here hardcodes it.
LLAMA_PIN_SHA=b23701f77d47dad9de834d59ebfcbe25c9e8b46f
LLAMA_SRC=/opt/heteroserve/llama.cpp
LLAMA_BIN=/opt/heteroserve/llama.cpp/build/bin
# Cortex-A76 is ARMv8.2-A: it adds FP16 arithmetic and the dotprod (SDOT/UDOT)
# instructions that the A72 on the Pi 4 lacks -- that difference is the single
# biggest reason the Pi 5 is the strong worker and is exactly what Phase 2 has to
# quantify. Note it does NOT have i8mm (ARMv8.6, Cortex-A710 and later), so do not
# pass +i8mm here; llama.cpp will build but the kernels trap at runtime.
# Flags are written out explicitly rather than -march=native so the build is
# reproducible and so the Pi4/Pi5 ISA difference is a recorded fact, not an accident.
LLAMA_ARCH_FLAGS="-march=armv8.2-a+crc+fp16+dotprod -mtune=cortex-a76"
LLAMA_THREADS=4
# Parallel build jobs. 8 GB is enough for -j4 on this tree.
BUILD_JOBS=4

# ---------- rpc-server ----------
RPC_HOST=0.0.0.0
RPC_PORT=50052
# Memory advertised to the control node's placement engine. Deliberately below
# NODE_USABLE_MB so the Pi never swaps or OOMs mid-run and corrupts a measurement.
# 6144 leaves ~1 GB of headroom against the 7 GB usable figure.
# NOTE: this figure is only honoured if the PINNED llama.cpp still has -m/--mem, which
# upstream removed on 2025-10-17 (41386cf). 04_install_services.sh probes the built
# binary and warns loudly when the node is advertising actual free memory instead.
RPC_MEM_MB=6144
# Where the rpc-server file cache lives. -c/--cache is a BOOLEAN flag in every upstream
# revision -- it takes no directory. The location comes from the LLAMA_CACHE environment
# variable, which the generated launcher sets from this value; the server then appends
# "rpc/" to it. Passing this as an argument to --cache makes rpc-server report an
# unknown argument and exit 0, which systemd cannot distinguish from a clean shutdown.
RPC_CACHE_DIR=/opt/heteroserve/rpc-cache

# ---------- node agent ----------
AGENT_PORT=9410

# ---------- power instrumentation ----------
# This node's channel on the Pico 2 DAQ. The INA226 sits high-side on the 5V USB-C
# rail, so EVERYTHING on that rail is measured: SoC, RAM, NVMe/microSD, Ethernet PHY
# and the active cooler.
# Channel/address map across the DAQ (four serving rails, one I2C bus):
#   ch1 0x40 pi5   ch2 0x41 pi4   ch3 0x44 jetson-nano   ch4 0x45 orangepi-rv2
INA_CHANNEL=1
INA_I2C_ADDR=0x40
INA_SHUNT_OHMS=0.01
# INTENT, NOT YET IMPLEMENTED. The Pi 5 can pull >3 A transiently under the 27W PD
# supply, so its channel wants a calibration range above the Pi 4's 3 A. Nothing reads
# this key: ThinkPad/firmware/pico2/main.py:53 hard-codes MAX_CURRENT_A = 3.2768 for
# ALL four channels, and ina226.py:45 derives current_lsb from it, so the signed 16-bit
# current register clips at 32767 * (3.2768/32768) = 3.2767 A. A Pi 5 load step above
# that is recorded AS 3.2767 A rather than as an error -- silently under-integrating
# this node's power peaks and making its joules-per-token look better than it is,
# while the Pi 4 (declaring 3.0 A, under the 3.2768 ceiling) is unaffected. That biases
# the Pi4-vs-Pi5 gap, which is the study's central number.
# Fix belongs in the firmware: per-channel max current sourced from cluster.json, plus
# a saturation guard that flags a clipped reading. Until then treat any Pi 5 sample at
# 3.2767 A as censored, not measured.
INA_MAX_A=5.0
PSU_MODEL="Official 27W USB-C PD"

# ---------- thermal / clocks ----------
# Reproducibility gate: the governor is pinned to performance and the active cooler
# is pinned to full for the duration of a sweep (risk R5 in the proposal). Runs are
# aborted if the SoC is above THERMAL_START_MAX_C when a cell begins.
CPU_GOVERNOR=performance
FAN_FORCE_FULL=1
THERMAL_START_MAX_C=55
# Pi 5 soft-throttles at 80 C and hard-throttles at 85 C.
THERMAL_THROTTLE_C=80

# ---------- data ----------
DATA_DIR=/opt/heteroserve/data
MODEL_DIR=/opt/heteroserve/models
RESULTS_DIR=/opt/heteroserve/results
