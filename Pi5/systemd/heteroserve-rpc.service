[Unit]
Description=HeteroServe Pi5 -- llama.cpp rpc-server (compute plane)
After=network-online.target heteroserve-prepare.service
Wants=network-online.target
# A permanently broken invocation must surface as `failed` rather than restarting for
# ever in silence. These two keys live in [Unit], not [Service] -- systemd-analyze
# ignores them with a warning if they are put under [Service].
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/heteroserve/node.env
# The launcher is GENERATED by 04_install_services.sh against the binary that was
# actually built, because upstream has changed this interface twice and the pinned
# SHA is chosen on the Jetson (CUDA 10.2), not here:
#   * the binary was renamed rpc-server -> ggml-rpc-server in c299a92 (2026-06-27)
#   * -m/--mem was removed in 41386cf (2025-10-17)
#   * -c/--cache has ALWAYS been a boolean; it takes no directory. Its location is
#     set through the LLAMA_CACHE environment variable instead.
# Passing a flag this build does not know is not a soft failure: rpc-server prints
# "error: unknown argument" and then calls exit(0), which Restart=on-failure reads as
# a clean shutdown -- the unit would sit dead with the port closed and no failure
# state. Hence the generated launcher, and Restart=always below.
# Read /opt/heteroserve/bin/rpc-server.sh to see exactly what was launched.
ExecStart=/opt/heteroserve/bin/rpc-server.sh
Restart=always
RestartSec=5
# Keep the worker off the swap path and pinned to the four A76 cores. A run that
# swaps is a corrupted measurement rather than a slow one.
MemoryMax=7G
MemorySwapMax=0
CPUAffinity=0-3
Nice=-5
StandardOutput=append:/opt/heteroserve/data/rpc-server.log
StandardError=append:/opt/heteroserve/data/rpc-server.log

[Install]
WantedBy=multi-user.target
